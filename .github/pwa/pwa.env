# PWA settings of this app (read by build.sh; uncomment a line to use it)

# Colour of the system bars (status bar / navigation bar) = manifest theme_color + <meta theme-color>.
THEME_COLOR="#000000"

# Colour of the splash screen = manifest background_color. If not set: the same as THEME_COLOR.
BACKGROUND_COLOR="#ffffff"

# 1 (default): the bar colour follows the colour of the current app theme (changes when the theme changes).
# 0: the bar colour stays fixed = THEME_COLOR.
THEME_SYNC=0

# Colour of the plate around the icon on the Android home screen (and of the frame on the Android 12 splash).
# Not set (default): no maskable icon, the system/launcher draws the plate itself.
# Set: the maskable icon with this solid colour is added to the manifest.
#MASKABLE_BG="#ffffff"
#MASKABLE_BG="#000000"
#MASKABLE_BG="#e41111"
